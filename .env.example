# Copy to .env and set real values before going live.
# Load them however your host prefers (systemd, Docker, a shell export).

# Port the server listens on
PORT=3000

# Turn on production mode: enables Secure cookies + HSTS.
# ONLY set this when the site is actually served over HTTPS.
NODE_ENV=production

# The admin account, created on first run.
ML_ADMIN_EMAIL=you@yourdomain.com
ML_ADMIN_PASSWORD=change-this-to-something-long-and-random

# Set to 1 ONLY if the app sits behind a reverse proxy you control
# (nginx, Caddy, Cloudflare). It makes rate limiting use X-Forwarded-For.
ML_TRUST_PROXY=1

# Optional: where the SQLite file lives (defaults to ./data)
# ML_DATA_DIR=/var/lib/maison-lunar

# Optional: log every request
# ML_LOG=1
